# Export these variables or inject them through the deployment environment.
# The app does not load .env automatically; enter teacher Gemini keys in the UI.
LP_GENERATION_MODEL=gemini-3.5-flash-lite
LP_DEFAULT_DURATION=60
LP_QDRANT_URL=http://localhost:6333
LP_COLLECTION=lesson_plan_v2
LP_CORPUS_DIRECTORY=data/processed/v2
LP_TIMEOUT_SECONDS=300
LP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LP_EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
LP_EMBEDDING_DIMENSION=384
LP_EMBEDDING_BATCH_SIZE=8
LP_INGESTION_BATCH_SIZE=8
